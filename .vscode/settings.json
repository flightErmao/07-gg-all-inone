{
    "editor.mouseWheelZoom": true,
    
    // 启用语义高亮
    "editor.semanticHighlighting.enabled": true,
    
    // 配置语义高亮颜色
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            // 函数定义 - 使用亮蓝色 (#4FC3F7)
            "function": {
                "foreground": "#4FC3F7"
            },
            "function.defaultLibrary": {
                "foreground": "#4FC3F7"
            },
            // 函数调用 - 使用柔和的黄色（不那么刺眼）
            // 从原来的 #FFD700（亮黄色）改为 #D4AF37（柔和的金黄色）
            "function.call": {
                "foreground": "#D4AF37"
            },
            "function.call.defaultLibrary": {
                "foreground": "#D4AF37"
            },
            // 全局变量 - 使用浅青色 (#4EC9B0)
            "variable": {
                "foreground": "#4EC9B0"
            },
            "variable.readonly": {
                "foreground": "#4EC9B0"
            },
            "variable.defaultLibrary": {
                "foreground": "#4EC9B0"
            }
        },
        // 针对特定主题的配置
        "[Default Dark+]": {
            "rules": {
                "function": "#4FC3F7",
                "function.call": "#D4AF37"
            }
        },
        "[Dark+]": {
            "rules": {
                "function": "#4FC3F7",
                "function.call": "#D4AF37"
            }
        }
    }
}