import rtconfig
from building import *
import os

Import('RTT_DIR')

cwd  = GetCurrentDir()
path = [cwd]
fatfs_dir = os.path.join(RTT_DIR, 'components', 'dfs', 'dfs_v1', 'filesystems', 'elmfat')
path += [fatfs_dir]
src = []

for root, dirs, files in os.walk(cwd):
    path.append(root)

    for name in files:
        if name.endswith(('.c', '.cpp')):
            src.append(os.path.relpath(os.path.join(root, name), cwd))

src += [
    os.path.join(fatfs_dir, 'ff.c'),
    os.path.join(fatfs_dir, 'ffunicode.c'),
]

group = DefineGroup('Applications', src, depend = [''], CPPPATH = path)

Return('group')
