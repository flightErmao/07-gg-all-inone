menuconfig WORK_TASK_MAG_REPORT_EN
    bool "ENABLE: WORK_TASK_MAG_REPORT_EN"
    default n
    help
       open mag report task

    if WORK_TASK_MAG_REPORT_EN

        config TASK_MAG_DEVICE_NAME
            string "Magnetometer device name"
            default "qmc6308"
            help
                Magnetometer device name used by rt_device_find.
                Valid values: qmc6308, qmc5883l.

        config TASK_MAG_ATKP_LOG_EN
            bool "Enable ATKP logging for magnetometer data"
            default n
            help
                Enable ATKP logging for magnetometer data transmission

            if TASK_MAG_ATKP_LOG_EN
                config TASK_MAG_ATKP_CHANNEL
                    int "ATKP channel number for magnetometer data"
                    range 1 8
                    default 2
                    help
                        ATKP channel number (1-8) for sending magnetometer data
            endif

        config TASK_MAG_SD_EVAL_UART_NAME
            string "UART device for SD influence evaluation stream"
            default "uart1"
            help
                UART device used to output raw magnetometer data for the PC evaluation tool.

        config TASK_MAG_SD_EVAL_UART_BAUD
            int "UART baudrate for SD influence evaluation stream"
            default 115200
            help
                Baudrate used by the evaluation data stream.

        config TASK_MAG_SD_EVAL_STREAM_PERIOD_MS
            int "Output period for SD influence evaluation stream (ms)"
            range 1 1000
            default 20
            help
                Output period in milliseconds for raw magnetometer data on the evaluation UART.

    endif

