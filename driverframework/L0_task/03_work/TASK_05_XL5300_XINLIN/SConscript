from building import *
import os

# 当前目录
cwd = GetCurrentDir()

# 仅编译必要源码，排除演示工程文件（main.c、uart.c、py32* 等）
src = [
    os.path.join(cwd, "src", "taskTofXl5300_xinlin.c"),
    os.path.join(cwd, "src", "XL5300_API.c"),
    os.path.join(cwd, "src", "XL5300_UserPlatform.c"),
    os.path.join(cwd, "src", "xl5300_port.c"),
    os.path.join(cwd, "src", "xl5300_fw_stub.c"),
]

# 如需静态库，请在上层 SConstruct 或此处根据工具链配置 LIBS/LIBPATH
# 例如：ENV = DefaultEnvironment(); ENV.Append(LIBS=["XL5300_Firmware_8", "das"], LIBPATH=[cwd])

# 头文件路径
CPPPATH = [cwd, os.path.join(cwd, "inc")]

group = DefineGroup(
    "TASK_05_XL5300_XINLIN",
    src,
    depend=["WORK_TASK_TOF_XL5300_XINLIN_EN"],
    CPPPATH=CPPPATH,
    CPPDEFINES=["USE_HAL_DRIVER", "STM32F4xx"],
)

Return("group")


