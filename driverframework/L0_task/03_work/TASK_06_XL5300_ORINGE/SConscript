from building import *
import os

# 获取当前目录
cwd = GetCurrentDir()
src = []
group = []

# 获取src目录下的所有源文件
src = Glob("./src/*.c")

# 包含路径
path = [cwd, os.path.join(cwd, "inc")]
# 添加 uartConfig 路径（如果启用 UART 输出）
uart_config_path = os.path.join("$(PROJECT_ROOT)", "driverframework", "L3_peripheral", "11_uartConfig")
path.append(uart_config_path)

# 定义编译组（受 Kconfig 开关控制）
group = DefineGroup(
    "TASK_06_XL5300_ORINGE",
    src,
    depend=["WORK_TASK_TOF_XL5300_ORINGE_EN"],
    CPPPATH=path,
)

Return("group")


