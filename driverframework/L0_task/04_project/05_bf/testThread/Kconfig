menuconfig PROJECT_BF_TEST_THREAD_EN
    bool "ENABLE: PROJECT_BF_TEST_THREAD_EN"
    default n
    help
        Enable test thread for subscribing imu_raw MCN topic and logging via mlog_gyro.

    if PROJECT_BF_TEST_THREAD_EN
        config PROJECT_BF_TEST_THREAD_STACK_SIZE
            int "Test Thread Stack Size (bytes)"
            range 512 4096
            default 2048
            help
                Stack size for the test thread in bytes. Default: 2048.

        config PROJECT_BF_TEST_THREAD_PRIORITY
            int "Test Thread Priority"
            range 1 32
            default 10
            help
                Priority for the test thread. Higher number means higher priority. Default: 10.

        config PROJECT_BF_TEST_THREAD_TIMESLICE
            int "Test Thread Time Slice (ticks)"
            range 1 100
            default 5
            help
                Time slice for the test thread in ticks. Default: 5.

        config PROJECT_BF_TEST_THREAD_DEBUG_PIN_EN
            bool "Enable Debug Pin for Mlog Timing Measurement"
            default y
            depends on L1_MIDDLEWARE_01_MODULE_03_DEBUGPIN_EN
            help
                Enable debug pin to measure mlog push data timing.
                The pin will be set HIGH during mlog push and LOW otherwise.
                Default: enabled.
    endif

