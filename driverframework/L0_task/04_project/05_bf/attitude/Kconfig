menuconfig PROJECT_BF_ATTITUDE_EN
    bool "ENABLE: PROJECT_BF_ATTITUDE_EN"
    default n
    depends on PROJECT_BF_GYRO_FILTER_EN
    help
        Enable Betaflight-style attitude estimation (roll/pitch angle calculation).
        This module fuses accelerometer and gyroscope data to estimate aircraft attitude.

    if PROJECT_BF_ATTITUDE_EN
        config PROJECT_BF_ATTITUDE_UPDATE_FREQ_HZ
            int "Attitude Update Frequency (Hz)"
            range 100 2000
            default 500
            help
                Frequency for attitude estimation update in Hz.
                Higher frequency improves responsiveness but increases CPU load.
                Betaflight uses 500Hz by default. Default: 500.

        config PROJECT_BF_ATTITUDE_DEBUG_PIN_EN
            bool "Enable Debug Pin for Attitude Timing Measurement"
            default n
            depends on L1_MIDDLEWARE_01_MODULE_03_DEBUGPIN_EN
            help
                Enable debug pin to measure attitude processing time.
                The pin will be set HIGH during attitude processing and LOW otherwise.

        config PROJECT_BF_ATTITUDE_THREAD_STACK_SIZE
            int "Attitude Thread Stack Size (bytes)"
            range 2048 8192
            default 4096
            help
                Stack size for the attitude estimation thread in bytes. Default: 4096.

        config PROJECT_BF_ATTITUDE_THREAD_PRIORITY
            int "Attitude Thread Priority"
            range 1 32
            default 10
            help
                Priority for the attitude estimation thread. Higher number means higher priority.
                Should be lower than motor thread (6). Default: 10.

        config PROJECT_BF_ATTITUDE_THREAD_TIMESLICE
            int "Attitude Thread Time Slice (ticks)"
            range 1 100
            default 5
            help
                Time slice for the attitude estimation thread in ticks. Default: 5.

        # ======== DEBUG: ANOTC (ATKP) ========
        menuconfig PROJECT_BF_ATTITUDE_ANOTC_LOG_EN
            bool "DEBUG: ANOTC (ATKP) Logging"
            default n
            depends on PROJECT_BF_ANOTC_EN
            help
                Enable ANOTC telemetry logging for attitude data (roll/pitch angles).

            if PROJECT_BF_ATTITUDE_ANOTC_LOG_EN
                config PROJECT_BF_ATTITUDE_ANOTC_LOG_PERIOD_MS
                    int "Attitude Log Period (ms)"
                    range 1 1000
                    default 20
                    help
                        Period (in milliseconds) for attitude data logging. Default: 20ms.
            endif
    endif

