menuconfig PROJECT_BF_WORKQUEUE_MANAGE_EN
    bool "ENABLE: PROJECT_BF_WORKQUEUE_MANAGE_EN"
    default n
    help
        Enable workqueue management system.
        Individual workqueues can be configured below.

    if PROJECT_BF_WORKQUEUE_MANAGE_EN

        # 速率控制工作队列
        config PROJECT_BF_WORKQUEUE_RATE_CTRL_EN
            bool "Enable Rate Control Workqueue"
            default y
            help
                Enable workqueue for rate control tasks.

        if PROJECT_BF_WORKQUEUE_RATE_CTRL_EN
            config PROJECT_BF_WORKQUEUE_RATE_CTRL_NAME
                string "Rate Control Workqueue Name"
                default "wq_rate_ctrl"
                help
                    Name of the workqueue for rate control jobs.

            config PROJECT_BF_WORKQUEUE_RATE_CTRL_STACK_SIZE
                int "Rate Control Workqueue Stack Size"
                range 512 4096
                default 1536
                help
                    Stack size for the rate control workqueue.

            config PROJECT_BF_WORKQUEUE_RATE_CTRL_PRIORITY
                int "Rate Control Workqueue Priority"
                range 1 32
                default 16
                help
                    Thread priority for the rate control workqueue.
                    Higher number = higher priority.
        endif

        # 可以在这里添加更多工作队列配置
        # 例如：
        # config PROJECT_BF_WORKQUEUE_SENSOR_EN
        #     bool "Enable Sensor Workqueue"
        #     default n
        #
        # if PROJECT_BF_WORKQUEUE_SENSOR_EN
        #     config PROJECT_BF_WORKQUEUE_SENSOR_NAME
        #         string "Sensor Workqueue Name"
        #         default "wq_sensor"
        #     ...
        # endif

    endif

