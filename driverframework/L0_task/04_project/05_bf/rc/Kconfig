menuconfig PROJECT_BF_RC_EN
    bool "ENABLE: PROJECT_BF_RC_EN"
    default n
    depends on PROJECT_BF_RATE_CTRL_EN
    help
        Enable Betaflight-style RC processing with thread support.

    if PROJECT_BF_RC_EN
        config PROJECT_BF_RC_DEVICE_NAME
            string "RC Device Name"
            default "rc"
            help
                Name of the RC device to open. Default: "rc"

        config PROJECT_BF_RC_THREAD_STACK_SIZE
            int "RC Thread Stack Size (bytes)"
            range 2048 8192
            default 2048
            help
                Stack size for the RC processing thread in bytes. Default: 2048.

        config PROJECT_BF_RC_THREAD_PRIORITY
            int "RC Thread Priority"
            range 1 32
            default 7
            help
                Priority for the RC processing thread. Higher number means higher priority.
                Should be lower than PID thread. Default: 7.

        config PROJECT_BF_RC_THREAD_TIMESLICE
            int "RC Thread Time Slice (ticks)"
            range 1 100
            default 5
            help
                Time slice for the RC processing thread in ticks. Default: 5.
    endif

