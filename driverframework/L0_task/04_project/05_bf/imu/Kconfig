menuconfig PROJECT_BF_BMI270_EN
    bool "Enable BMI270 Betaflight-style IMU Sensor"
    default n
    select PROJECT_BF_COMMON_EN
    select BSP_USING_SPI
    help
        Enable BMI270 IMU driver for Betaflight-style project (no FIFO, DRDY interrupt + register read).

    if PROJECT_BF_BMI270_EN

        config SENSOR_SPI_NAME_BMI270_BF
            string "BMI270 BF SPI bus name"
            default "spi1"

        config SENSOR_SPI_SLAVE_NAME_BMI270_BF
            string "BMI270 BF SPI device name"
            default "spi10"

        config SENSOR_BMI270_BF_SPI_MAX_HZ
            int "BMI270 BF SPI max frequency (Hz)"
            default 10000000
            range 100000 20000000

        config SENSOR_BMI270_BF_SPI_CS_PIN
            string "BMI270 BF SPI CS pin"
            default "PA4"

        config SENSOR_BMI270_BF_INT_PIN
            string "BMI270 BF interrupt pin"
            default "PA15"

        choice
            prompt "BMI270 BF output data rate"
            default SENSOR_BMI270_BF_ODR_3200HZ
            help
                Select the IMU output data rate (ODR) for both accelerometer and gyro.
                Higher ODR improves bandwidth but increases CPU load.

        config SENSOR_BMI270_BF_ODR_800HZ
            bool "800 Hz"

        config SENSOR_BMI270_BF_ODR_1600HZ
            bool "1600 Hz"

        config SENSOR_BMI270_BF_ODR_3200HZ
            bool "3200 Hz"

        endchoice

        choice
            prompt "BMI270 BF trigger mode"
            default SENSOR_BMI270_BF_TRIGGER_INTERRUPT
            help
                Select how to trigger IMU data reading:
                - Interrupt: Use hardware interrupt (DRDY pin) for accurate timing
                - Hardware timer: Use hardware timer for periodic triggering (based on ODR)

        config SENSOR_BMI270_BF_TRIGGER_INTERRUPT
            bool "Hardware interrupt (DRDY pin)"

        config SENSOR_BMI270_BF_TRIGGER_TIMER
            bool "Hardware timer"
            depends on RT_USING_HWTIMER
            help
                Use hardware timer to trigger IMU data reading at configured ODR rate.
                Timer frequency will be automatically set based on selected ODR.

        endchoice

        config SENSOR_BMI270_BF_HWTIMER_DEV_NAME
            string "BMI270 BF hardware timer device name"
            default "timer1"
            depends on SENSOR_BMI270_BF_TRIGGER_TIMER
            help
                Hardware timer device name to use for triggering IMU data reading.
                Examples: "timer1", "timer2", "timer3", etc.
                Timer frequency will be set automatically based on selected ODR.

        config PROJECT_BF_BMI270_DEBUG_PIN_EN
            bool "Enable Debug Pin for Timing Measurement"
            default n
            depends on L1_MIDDLEWARE_01_MODULE_03_DEBUGPIN_EN


        endif




