from building import *
import os

cwd = GetCurrentDir()

src = Glob("./src/*.cpp")

include_paths = [
    cwd,
    os.path.join(cwd, "inc"),  # gyro_mcn.h, pid_mcn.h, rc_bf.hpp
    os.path.join(cwd, "../common/inc"),  # init_sync.h 所在目录
    os.path.join(cwd, "../rc/inc"),  # rc_bf.h
    os.path.join(cwd, "../param/inc"),  # param.h (getParam function)
    os.path.join(cwd, "../gyroFilter/inc"),  # gyro_mcn.h
    os.path.join(cwd, "../anotc/inc"),  # anotc_bf.h, protocolAtkpInterface.h
    os.path.join(cwd, "../motor/inc"),  # motor_bf.h (for subTaskMotorUpdate)
    os.path.join(cwd, "../imu/inc"),
    os.path.join(cwd, "../gyro/inc"),  # gyro_mcn.h
    os.path.join(cwd, "../attitude/inc"),  # attitude_mcn.h (for angle mode)
    os.path.join(cwd, "..", "..", "..", "..", "L1_middleWare", "01_module", "05_timestamp", "inc"),  # timestamp.h
    os.path.join(cwd, "..", "..", "..", "..", "L1_middleWare", "01_module", "03_debugPin"),  # debugPin.h 所在目录
    os.path.join(cwd, "..", "..", "..", "..", "L1_middleWare", "06_bf_lib", "common", "inc"),  # filter.h
]

depend_list = [
    "PROJECT_BF_PID_EN",
    "PROJECT_BF_GYRO_FILTER_EN",  # Depends on gyro filter for gyro_filtered data
    "PROJECT_BF_RC_EN",  # Depends on RC module for RcBf class
    "PROJECT_BF_PARAM_EN",  # getParam function
]

# Optional dependencies (will be checked at compile time via #ifdef)
# Note: These are not strictly required for compilation, but are needed at runtime
# if GetDepend("PROJECT_BF_ANOTC_EN"):
#     depend_list.append("PROJECT_BF_ANOTC_EN")  # Depends on ANOTC for logging functions
# if GetDepend("PROJECT_BF_ATTITUDE_EN"):
#     depend_list.append("PROJECT_BF_ATTITUDE_EN")  # Depends on attitude module for angle mode

group = DefineGroup(
    "PROJECT_BF_PID_EN",
    src,
    depend=depend_list,
    CPPPATH=include_paths,
)

Return("group")

