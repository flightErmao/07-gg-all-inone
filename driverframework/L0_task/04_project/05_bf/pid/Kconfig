menuconfig PROJECT_BF_PID_EN
    bool "ENABLE: PROJECT_BF_PID_EN"
    default n
    depends on PROJECT_BF_RATE_CTRL_EN
    help
        Enable Betaflight-style PID controller.

    if PROJECT_BF_PID_EN
        config PROJECT_BF_PID_THREAD_STACK_SIZE
            int "PID Thread Stack Size (bytes)"
            range 2048 8192
            default 4096
            help
                Stack size for the PID controller thread in bytes. Default: 4096.

        config PROJECT_BF_PID_THREAD_PRIORITY
            int "PID Thread Priority"
            range 1 32
            default 8
            help
                Priority for the PID controller thread. Higher number means higher priority. 
                Should be lower than rate control thread. Default: 8.

        config PROJECT_BF_PID_THREAD_TIMESLICE
            int "PID Thread Time Slice (ticks)"
            range 1 100
            default 5
            help
                Time slice for the PID controller thread in ticks. Default: 5.
    endif

