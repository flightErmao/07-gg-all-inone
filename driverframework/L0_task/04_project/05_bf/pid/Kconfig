menuconfig PROJECT_BF_PID_EN
    bool "ENABLE: PROJECT_BF_PID_EN"
    default n
    depends on PROJECT_BF_GYRO_FILTER_EN
    help
        Enable Betaflight-style PID controller.

    if PROJECT_BF_PID_EN
        config PROJECT_BF_PID_THREAD_STACK_SIZE
            int "PID Thread Stack Size (bytes)"
            range 2048 8192
            default 4096
            help
                Stack size for the PID controller thread in bytes. Default: 4096.

        config PROJECT_BF_PID_THREAD_PRIORITY
            int "PID Thread Priority"
            range 1 32
            default 7
            help
                Priority for the PID controller thread. Higher number means higher priority. 
                Should be lower than gyro filter thread. Default: 8.

        config PROJECT_BF_PID_THREAD_TIMESLICE
            int "PID Thread Time Slice (ticks)"
            range 1 100
            default 5
            help
                Time slice for the PID controller thread in ticks. Default: 5.

        config PROJECT_BF_PID_DEBUG_PIN_EN
            bool "ENABLE: PID Debug Pin"
            default n
            depends on L1_MIDDLEWARE_01_MODULE_03_DEBUGPIN_EN
            help
                Enable debug pin for PID task monitoring:
                - DEBUG1: PID thread execution frequency (~3.2kHz)
                  Toggles at pidMainLoop() while loop start/end

        config PROJECT_BF_PID_D_MAX_EN
            bool "ENABLE: D_MAX (Dynamic D-term Gain Boost)"
            default n
            help
                Enable D_MAX feature for dynamic D-term gain boost.
                D_MAX increases D-term gain when rapid changes are detected
                (e.g., propwash), helping to suppress oscillations.
                This feature is useful for improving stability during aggressive maneuvers.

        # ======== DEBUG: ANOTC (ATKP) ========
        menuconfig PROJECT_BF_PID_ANOTC_LOG_EN
            bool "DEBUG: ANOTC (ATKP) Logging"
            default n
            depends on PROJECT_BF_ANOTC_EN
            help
                Enable ANOTC telemetry logging for PID rate setpoint and actual rate.

            if PROJECT_BF_PID_ANOTC_LOG_EN

                menuconfig PROJECT_BF_PID_ANOTC_LOG_ANGULAR_RATE_EN
                    bool "DEBUG: ANOTC (ATKP) Angular Rate Logging"
                    default n
                    depends on PROJECT_BF_ANOTC_EN
                    help
                        Enable ANOTC telemetry logging for PID angular rate setpoint and actual rate.
                    
                    if PROJECT_BF_PID_ANOTC_LOG_ANGULAR_RATE_EN
                        config PROJECT_BF_PID_ANOTC_LOG_ANGULAR_RATE_GROUP
                            int "Log Group ID for Angular Rate Setpoint/Actual"
                            range 1 99
                            default 1
                            help
                                Set the group ID for angular rate setpoint/actual logging (1-99).
                                Default: 1.

                        config PROJECT_BF_PID_ANOTC_LOG_ANGULAR_RATE_PERIOD_MS
                            int "Angular Rate Log Period (ms)"
                            range 1 1000
                            default 20
                            help
                                Period (in milliseconds) for angular rate setpoint/actual logging. Default: 20ms.
                endif

                menuconfig PROJECT_BF_PID_ANOTC_LOG_PITCH_PIDF_EN
                    bool "DEBUG: ANOTC (ATKP) Pitch PIDF Logging"
                    default n
                    depends on PROJECT_BF_ANOTC_EN
                    help
                        Enable ANOTC telemetry logging for pitch axis PIDF (P, I, D, F) and sum data.
                    
                    if PROJECT_BF_PID_ANOTC_LOG_PITCH_PIDF_EN
                        config PROJECT_BF_PID_ANOTC_LOG_PITCH_PIDF_GROUP
                            int "Log Group ID for Pitch PIDF Data"
                            range 1 99
                            default 2
                            help
                                Set the group ID for pitch PIDF data logging (1-99).
                                Default: 2.

                        config PROJECT_BF_PID_ANOTC_LOG_PITCH_PIDF_PERIOD_MS
                            int "Pitch PIDF Log Period (ms)"
                            range 1 1000
                            default 20
                            help
                                Period (in milliseconds) for pitch PIDF data logging. Default: 20ms.
                endif

            endif
    endif

