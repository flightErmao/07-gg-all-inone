from building import *
import os

cwd = GetCurrentDir()

# Matrix library only contains header files, no source files
src = []

# Add both the base directory (for matrix/math.hpp wrapper) and inc directory
# The wrapper allows <matrix/math.hpp> to work correctly
inc_dir = os.path.join(cwd, "inc")
px4_common_dir = os.path.join(cwd, "px4_platform_common")
include_paths = [cwd, inc_dir, px4_common_dir]

group = DefineGroup(
    "L1_MIDDLEWARE_05_PX4_LIB_03_MATRIX_EN",
    src,
    depend=["L1_MIDDLEWARE_05_PX4_LIB_03_MATRIX_EN"],
    CPPPATH=include_paths,
)

Return("group")


